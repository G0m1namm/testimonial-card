---
const { name, handle, avatar } = Astro.props;
---

<article aria-labelledby="testimonial-card-title" class="w-full h-full shadow bg-white rounded-lg inline-block">
	<div class="flex flex-col p-6 gap-4">
		<div class="flex gap-4">
			<figure class="flex-none w-12 h-12 rounded-full overflow-hidden block">
				<img
					src={avatar.src}
					alt={name}
					loading="eager"
					decoding="async"
					width={avatar.width}
					height={avatar.height}
					class="w-full h-full object-cover bg-gray"
				/>
			</figure>
			<div class="flex-1 flex flex-col gap-px">
				<h3 id="testimonial-card-title" class="text-lg font-semibold line-clamp-1">{name}</h3>
				<span class="text-sm line-clamp-1">{handle}</span>
			</div>
		</div>
		<p class="text-base line-clamp-5">
			<slot/>
		</p>
	</div>
</article>
